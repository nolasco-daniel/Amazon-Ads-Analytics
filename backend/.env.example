# ── Amazon Advertising API credentials ──
# Copy this file to ".env" and fill in your real values. Never commit .env.

# From your Login with Amazon (LWA) application
ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
ADS_CLIENT_SECRET=your-client-secret
# Obtained once via the OAuth consent flow (authorize your own Ads account)
ADS_REFRESH_TOKEN=Atzr|xxxxxxxx

# The advertising profile (account/marketplace) you want to pull.
# Fetch it from GET /v2/profiles after auth works. Leave blank for now.
ADS_PROFILE_ID=

# Regional API host: NA / EU / FE
#   NA -> https://advertising-api.amazon.com
#   EU -> https://advertising-api-eu.amazon.com
#   FE -> https://advertising-api-fe.amazon.com
ADS_API_HOST=https://advertising-api.amazon.com

# Token endpoint (region-matched). NA/global default below.
ADS_TOKEN_URL=https://api.amazon.com/auth/o2/token

# Local server port
PORT=4000

# How many recent days each "Refresh data" pull re-requests (attribution keeps
# updating for ~48–72h, so we re-pull a window). Optional; default 14.
REFRESH_DAYS=14
# Daily auto-refresh time as a cron expression (server timezone). Optional;
# default '0 6 * * *' = 06:00.
REFRESH_CRON=0 6 * * *

# ── AI chatbot (Google Gemini) ──
# Powers the dashboard chat assistant. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8-xxxxxxxx
